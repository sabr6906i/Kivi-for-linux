# Generated by scripts/build-arch.sh. Do not replace the source digest with SKIP.
pkgname=bol-linux
pkgver=@VERSION@
pkgrel=1
pkgdesc='Voice dictation, writing and audio workspace for Linux (Hyprland support)'
arch=('any')
url='https://github.com/sabr6906i/Kivi-for-linux'
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'tk' 'pipewire' 'wl-clipboard' 'libnotify' 'ffmpeg')
optdepends=('xclip: clipboard transport on X11 sessions'
            'xdotool: focus-checked insertion on X11 sessions'
            'xorg-xprop: app-class detection on X11 sessions'
            'hyprland: tested global shortcuts, focused-window detection and text insertion'
            'nodejs: optional ElevenLabs browser-sign-in helper'
            'npm: optional ElevenLabs browser-sign-in helper'
            'whisper.cpp: optional local speech recognition; requires a model')
options=('!debug')
source=("bol-linux-${pkgver}.tar.gz::https://github.com/sabr6906i/Kivi-for-linux/releases/download/@TAG@/bol-linux-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "Kivi-for-linux-${pkgver}"
    install -d "$pkgdir/usr/lib/bol-linux/icons" "$pkgdir/usr/lib/bol-linux/themes"
    install -m755 kivi_linux.py "$pkgdir/usr/lib/bol-linux/bol.py"
    install -m644 bol_*.py "$pkgdir/usr/lib/bol-linux/"
    install -m644 icons/*.svg "$pkgdir/usr/lib/bol-linux/icons/"
    install -m644 themes/*.svg "$pkgdir/usr/lib/bol-linux/themes/"
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/bol" <<'LAUNCHER'
#!/bin/sh
exec /usr/bin/python /usr/lib/bol-linux/bol.py "$@"
LAUNCHER
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.github.sabr6906i.Bol.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Bol
Comment=Voice dictation and writing workspace
Exec=bol settings
Icon=io.github.sabr6906i.Bol
Terminal=false
Categories=Utility;Accessibility;Audio;
Keywords=Voice;Dictation;Speech;Whisper;
StartupNotify=true
DESKTOP
    install -Dm644 icons/brand.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.sabr6906i.Bol.svg"
    install -Dm644 README.md "$pkgdir/usr/share/doc/bol-linux/README.md"
    install -Dm644 docs/DESKTOPS.md "$pkgdir/usr/share/doc/bol-linux/DESKTOPS.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/bol-linux/LICENSE"
}
